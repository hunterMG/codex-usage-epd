display:
  width: 400
  height: 300
  model_id: 0x02        # SSD1683/SSD1619 400x300 B/W/R
  sleep_after_push: false   # web client never sends SLEEP; early sleep aborts refresh

ble:
  device: "auto"         # "auto" (scan NRF_EPD) | MAC address | name substring
  mtu: 247
  scan_timeout: 10       # seconds per scan attempt
  scan_retries: 3        # retry the scan before giving up (missed adv packets)
  interleave: 50         # match web client: 50 writes w/o response, then 1 with
  patch_wakeup_pin: true
  pacing_ms: 0.0         # no pacing (web client sends back-to-back)
  hold_after_refresh: 15.0  # stay connected until panel busy refresh completes
  slot: 0                # epdiy.cn slot firmware: image slot to write (0..N-1);
                         # "auto" = first free slot; -1 / "none" = no SET_SLOT cmd

codex:
  auth_file: "~/.codex/auth.json"
  timeout: 15

render:
  font: ""               # empty = auto-detect; or path to a .ttf
  warn_threshold: 20     # remaining % below this renders the bar red
  preview: "preview.png"

schedule:
  interval_minutes: 5    # used by --loop / launchd